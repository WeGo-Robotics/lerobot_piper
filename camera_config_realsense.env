# PiPER data collection camera configuration.
# Usage:
#   cd /home/liyuqi/Documents/Piper/lerobot_piper-piper
#   source ./camera_config_realsense.env
#   ./record_with_pc_relay.sh

# Camera #0 from `lerobot-find-cameras realsense`.
# Physical role: wrist camera mounted on follower PiPER.
export WRIST_REALSENSE_SERIAL="238222076529"

# Camera #1 from `lerobot-find-cameras realsense`.
# Physical role: global/static camera.
export GLOBAL_REALSENSE_SERIAL="142122071524"

# Use Intel RealSense native camera backend.
export ROBOT_CAMERAS='{ wrist: {type: intelrealsense, serial_number_or_name: "238222076529", width: 640, height: 480, fps: 15}, global: {type: intelrealsense, serial_number_or_name: "142122071524", width: 640, height: 480, fps: 15} }'
